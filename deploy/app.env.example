DOCTRAD2_ROOT=/var/lib/doctrad2
DOCTRAD2_DATABASE=postgresql+psycopg://doctrad2:LOCAL_PASSWORD@127.0.0.1/doctrad2
DOCTRAD2_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DOCTRAD2_LLM_URL=http://192.168.6.250:8098
DOCTRAD2_LLM_KEY=REPLACE_WITH_LOCAL_RUNTIME_API_KEY
DOCTRAD2_MODEL_SHA=REPLACE_WITH_SHA256_OF_EXISTING_GGUF
DOCTRAD2_RUNTIME_SHA=REPLACE_WITH_SHA256_OF_EXISTING_LLAMA_SERVER
DOCTRAD2_SECURE_COOKIE=1
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
